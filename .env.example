# Пример конфигурации SRS Audit. Скопируйте в .env и укажите ключ ОДНОГО провайдера LLM.
# ВНИМАНИЕ: файл .env с реальными ключами никогда не коммитится (он в .gitignore).

# --- Google Gemini API (рекомендуется, бесплатный ключ: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Модель Gemini. Рекомендуется gemini-2.5-flash (замер: 52/52 требований, ~40 с на самый крупный вызов).
# При 503/429/таймауте агент сам переключится на gemini-flash-latest, затем на gemini-flash-lite-latest.
GEMINI_MODEL=gemini-2.5-flash

# --- Либо другие провайдеры (используется первый найденный ключ: Gemini → OpenAI → Anthropic → Ollama) ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5

# Локальные модели (Ollama / vLLM, OpenAI-совместимый API):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# --- Необязательные настройки агента ---
# Явный выбор модели с префиксом провайдера (перекрывает всё выше), то же, что --model:
# SRS_MODEL=google:gemini-flash-latest
# Запасные модели через запятую (FallbackModel при 429 / исчерпании квоты / недоступности):
# SRS_FALLBACK_MODELS=google:gemini-flash-lite-latest
# Лимит запросов в минуту (Free Tier Gemini — 10 RPM для Flash; держим запас):
# SRS_RPM=8
